# Copy to .env and fill in your own values. Never commit .env.
# All values below are placeholders — no personal data here.

# Where your Hermes lives (profiles, skills, kanban.db)
HERMES_HOME=$HOME/.hermes

# Obsidian vault root (explorer / graph)
OBSIDIAN_VAULT_PATH=$HOME/notes

# Shown on the Obsidian service card (your own repo or empty)
OBSIDIAN_GIT_REMOTE=

# Workspace drive storage (per-agent subfolders are created here)
AGENT_WORKSPACE_DIR=$HOME/workspace

# Pipeline master copies
REVENUE_OPS_DIR=$HOME/revenue-ops

# Fallback target chat for the Telegram card (your own chat id or empty)
TELEGRAM_CHAT_ID=

# Label on the memory view
OPERATOR_NAME=Operator

# HTTP port
PORT=3000
